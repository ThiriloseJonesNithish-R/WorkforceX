# ====================================================================
# WorkForceX Environment Configuration Template
# Copy this file to '.env' and adjust the values as needed.
# ====================================================================

# MongoDB Connection URI (Local portable server or MongoDB Atlas)
# Default for bundled local portable MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017

# For MongoDB Atlas cloud cluster:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Secret key for signing JWT authentication tokens (generate a strong random string)
JWT_SECRET=your_jwt_secret_key_here

# Groq Cloud API Key for AI Recruitment Assistant & Career Coach (optional)
# Obtain a free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Custom folder path for uploaded resumes (defaults to backend/uploads)
# UPLOAD_FOLDER=backend/uploads
